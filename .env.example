# Environment configuration for Signal Clone Microservices
# Copy or edit to configure your production or staging environment

# App configuration
ENVIRONMENT=development
PROJECT_NAME="Signal Clone API"
SECRET_KEY=signal-super-secret-jwt-key-2026-production-ready-min-32-chars

# PostgreSQL Database
POSTGRES_USER=signal_admin
POSTGRES_PASSWORD=SuperSecretSignalPass2026!
POSTGRES_DB=signal_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://signal_admin:SuperSecretSignalPass2026!@localhost:5432/signal_db

# Redis Cache & PubSub Broker
REDIS_PASSWORD=SignalRedisSecure2026!
REDIS_PORT=6379
REDIS_URL=redis://:SignalRedisSecure2026!@localhost:6379/0

# Database Pooling
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# Security
FIXED_OTP=123456
